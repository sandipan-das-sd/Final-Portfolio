# Neon Postgres (or Vercel Postgres/Neon integration)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require

# Protects /admin and /api/admin/* with HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Vercel Blob — required only for thumbnail and résumé uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Optional: emails contact-form submissions through Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
